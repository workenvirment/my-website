# =============================================================================
# DGW SOLUTIONS LLC - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Note: If these are left blank, the application will automatically run in
# high-fidelity Demo / Simulation mode without crashing or throwing errors!
# =============================================================================

# Firebase Google Authentication & Services
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Configuration (Optional override)
VITE_PORT=5173
VITE_HOST=0.0.0.0

# Logistics Operations Contact Information
VITE_SUPPORT_PHONE=+1 (800) DGW-LOAD
VITE_SUPPORT_EMAIL=dispatch.ops@dgwsolutions.com
